    "w_topic": "sky", "w_rules": "orange", "w_design": "violet",
}
STEP_COLORS = ["coral", "violet", "green"]


def swatch(name):
    """요소 하나에 색 하나를 입히는 CSS 변수 묶음"""
    return f"--c:var(--{name});--cl:var(--{name}-l);--tx:var(--{name}-t);"


def chip_css(key, names):
    """라디오 선택지(칩)를 순서대로 다른 색으로"""
    return "".join(
        f'.stApp .st-key-{key} [role="radiogroup"]>label:nth-child({i}){{{swatch(n)}}}'
        for i, n in enumerate(names, 1)
    )


FONT_IMPORT = "@import url('https://fonts.googleapis.com/css2?family=Gowun+Dodum&family=Jua&display=swap');"

DYNAMIC_CSS = (
    f":root{{--ink:{INK};--soft:{SOFT};"
    + "".join(f"--{n}:{c};--{n}-l:{l};--{n}-t:{t};" for n, (c, l, t) in PALETTE.items())
    + "}"
    + "".join(f".stApp .st-key-{k}{{{swatch(v)}}}" for k, v in FIELD_COLORS.items())
    + "".join(f".stApp .st-key-panel{i}{{{swatch(v)}}}" for i, v in enumerate(STEP_COLORS, 1))
    + chip_css("w_type", TYPE_COLORS)
    + chip_css("w_grade", GRADE_COLORS)
)

