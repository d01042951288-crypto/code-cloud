st.markdown("<style>" + FONT_IMPORT + DYNAMIC_CSS + STATIC_CSS + "</style>", unsafe_allow_html=True)


# ── 화면을 꾸미는 작은 도우미 함수들 ──────────────────────
def put_html(markup):
    """HTML을 한 줄로 이어 붙여서 내보낸다 (줄바꿈·들여쓰기가 코드 블록으로 오해되지 않게)"""
    st.markdown(" ".join(markup.split()), unsafe_allow_html=True)


def panel(key):
    """단계별 종이 한 장. 오래된 Streamlit이면 색 없이 그냥 묶기만 한다."""
    try:
        return st.container(key=key)
    except TypeError:
        return st.container()


def step_header(number, title, color):
    put_html(
        f'<div class="step-header" style="{swatch(color)}">'
        f'<span class="badge">STEP {number}</span><span class="step-title">{title}</span></div>'
    )


def bubble(text, color):
    put_html(f'<div class="bubble" style="{swatch(color)}"><span class="mascot">🤖</span><p>{text}</p></div>')


def hero():
    words = ["나만의", "학습게임", "기획하기"]
    colors = ["sun", "coral", "sky", "green", "violet", "orange", "pink", "mint", "sun", "coral", "sky"]
    tilts = [-4, 3, -2, 4, -3, 2, -4, 3, -2, 4, -3]
    i, groups = 0, []
    for word in words:
        tiles = ""
        for ch in word:
            tiles += f'<span class="tile" aria-hidden="true" style="{swatch(colors[i])}--r:{tilts[i]}deg">{ch}</span>'
            i += 1
        groups.append(f'<span class="word">{tiles}</span>')
    put_html(
        '<div class="hero">'
        f'<div class="hero-title" role="heading" aria-level="1" aria-label="{" ".join(words)}">{"".join(groups)}</div>'
        '<div class="tagline">🎮 기획은 내가, 코딩은 AI가!</div>'
        '</div>'
    )


def gauge(filled):
    """제목·주제·규칙·디자인 네 칸 중 몇 칸을 채웠는지 보여준다"""
    parts = [("제목", "coral"), ("주제", "sky"), ("규칙", "orange"), ("디자인", "violet")]
    segs = "".join(
        f'<span class="seg{" on" if ok else ""}" style="{swatch(color)}">{"✓ " if ok else ""}{name}</span>'
        for (name, color), ok in zip(parts, filled)
    )
    done = sum(filled)
    if done == 0:
        msg = "아직 비어 있어요. 게임 제목부터 정해볼까요?"
    elif done < 4:
        msg = f"좋아요! {4 - done}칸만 더 채우면 기획서 완성!"
    else:
