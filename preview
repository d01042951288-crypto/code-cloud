    "orange": ("#FF9F43", "#FFE8CF", INK),
    "sun":    ("#FFD43B", "#FFF3BD", INK),
    "green":  ("#4CD787", "#D9F7E5", INK),
    "mint":   ("#2EDCC0", "#D2F8F1", INK),
    "sky":    ("#4DB8FF", "#D9F0FF", INK),
    "violet": ("#7A5AF8", "#ECE6FF", "#FFFFFF"),
    "pink":   ("#FF8FD0", "#FFE2F4", INK),
}

# 게임 종류 8가지, 학년 6단계가 차례로 입을 색
TYPE_COLORS = ["sun", "coral", "orange", "green", "sky", "violet", "pink", "mint"]
